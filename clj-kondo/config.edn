;; Copy this directory to your project's .clj-kondo/, or add it to
;; :config-paths. The rules then fire in the editor and at the REPL, not only
;; when SonarQube runs, and their findings reach the plugin through the same
;; JSON report it already imports.
{:hooks
 {:analyze-call
  {java.security.MessageDigest/getInstance hbt.security/weak-hash
   javax.crypto.Cipher/getInstance         hbt.security/cipher
   javax.net.ssl.SSLContext/getInstance    hbt.security/tls-protocol

   clojure.core/eval                       hbt.security/eval-call
   clojure.core/load-string                hbt.security/eval-call
   clojure.core/read-string                hbt.security/read-string-call

   clojure.core/resolve                    hbt.security/reflective
   clojure.core/ns-resolve                 hbt.security/reflective
   clojure.core/requiring-resolve          hbt.security/reflective

   clojure.core/rand                       hbt.security/insecure-random
   clojure.core/rand-int                   hbt.security/insecure-random
   clojure.core/rand-nth                   hbt.security/insecure-random
   clojure.core/shuffle                    hbt.security/insecure-random

   clojure.java.shell/sh                   hbt.security/shell
   babashka.process/shell                  hbt.security/shell
   babashka.process/process                hbt.security/shell

   next.jdbc/execute!                      hbt.security/sql
   next.jdbc/execute-one!                  hbt.security/sql
   next.jdbc/plan                          hbt.security/sql
   clojure.java.jdbc/query                 hbt.security/sql
   clojure.java.jdbc/execute!              hbt.security/sql}}

 :linters
 {:hbt/weak-hash-algorithm    {:level :error}
  :hbt/cipher-ecb-mode        {:level :error}
  :hbt/weak-cipher-algorithm  {:level :error}
  :hbt/weak-tls-protocol      {:level :error}
  :hbt/eval-of-dynamic-value  {:level :error}
  :hbt/read-string-untrusted  {:level :error}
  :hbt/reflective-call        {:level :warning}
  :hbt/insecure-random        {:level :warning}
  :hbt/shell-command-injection {:level :error}
  :hbt/sql-string-built       {:level :error}}}
