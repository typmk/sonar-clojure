;; What each case must produce, and must not.
;;
;; :expect  rules that MUST fire. Empty means the file is safe and any finding
;;          against it is a false positive.
;; :why     the reason this case exists, so a future reader can tell a
;;          deliberate hard negative from an oversight.
;; :known-miss  engines measured NOT to catch this, with the reason. Recorded
;;          rather than deleted: a case removed because a tool fails it stops
;;          being evidence about the tool.

[{:file "sqli_direct.clj" :cwe 89 :expect #{"clj-sql-injection"}
  :why "source and sink in one form -- the easiest case there is"}

 {:file "sqli_via_helper.clj" :cwe 89 :expect #{"clj-sql-injection"}
  :why "taint returns from a helper; needs interprocedural propagation"}

 {:file "sqli_into_callee.clj" :cwe 89 :expect #{"clj-sql-injection"}
  :why "taint passed INTO a callee whose body holds the sink -- the commonest
        real shape, and the one that needs --taint-intrafile"}

 {:file "safe_parameterised.clj" :cwe 89 :expect #{}
  :why "HARD NEGATIVE. The tainted value IS present at the call, bound as a
        parameter. Distinguishing this from sqli_direct is the whole job; a
        sink pattern without focus-metavariable flags it"}

 {:file "safe_static_sql.clj" :cwe 89 :expect #{}
  :why "no user input anywhere"}

 {:file "safe_sql_from_config.clj" :cwe 89 :expect #{}
  :why "HARD NEGATIVE. The statement is computed rather than literal, which
        looks like string building, but the source is a private map"}

 {:file "cmdi_direct.clj" :cwe 78 :expect #{"clj-command-injection"}
  :why "user input concatenated into a shell string"}

 {:file "safe_fixed_command.clj" :cwe 78 :expect #{}
  :why "a shell call with no attacker-controlled argument is not a finding"}

 {:file "codei_read_string.clj" :cwe 94 :expect #{"clj-code-injection"}
  :why "read-string evaluates reader tags; with eval it is remote code
        execution"}

 {:file "safe_edn_read.clj" :cwe 94 :expect #{}
  :why "HARD NEGATIVE. clojure.edn/read-string does not evaluate. It is the
        fix, and a rule that flags it teaches people to ignore the rule"}

 {:file "xss_raw.clj" :cwe 79 :expect #{"clj-xss-unescaped"}
  :why "hiccup's raw exists to bypass escaping"}

 {:file "safe_escaped.clj" :cwe 79 :expect #{}
  :why "HARD NEGATIVE. escape-html is the sanitiser"}

 {:file "path_traversal.clj" :cwe 22 :expect #{"clj-path-traversal"}
  :why "a filename from the request reaches io/file"}

 {:file "safe_fixed_path.clj" :cwe 22 :expect #{}
  :why "constant path"}

 {:file "ssrf.clj" :cwe 918 :expect #{"clj-ssrf"}
  :why "a URL from the request reaches an outbound client"}

 {:file "safe_fixed_url.clj" :cwe 918 :expect #{}
  :why "constant URL"}

 ;; --- Idiomatic Clojure the ruleset was NOT written against. These were
 ;; added blind, to find out what the engine does rather than to confirm what
 ;; it already did. A corpus written by the same hand as the rules, in the same
 ;; hour, proves almost nothing; these are the cases that carry information.

 {:file "hard_thread_last.clj" :cwe 89 :expect #{"clj-sql-injection"}
  :why "->> threading. The sink call never appears in source order. Was a
        known miss: the sink pattern required a literal [sql ...] argument and
        the vector arrives through the macro. Closed by matching the threaded
        shape as well"}

 {:file "hard_safe_thread_param.clj" :cwe 89 :expect #{}
  :why "HARD NEGATIVE, and the price of the case above. A correctly
        parameterised call written in threaded style: the tainted value is
        bound as a parameter. Matching the threaded shape flagged it until the
        rule excluded a threaded vector whose first element is a string
        literal"}

 {:file "hard_destructured.clj" :cwe 89 :expect #{"clj-sql-injection"}
  :why "the source is an associative destructuring form, not a get-in call"
  :known-miss
  ;; Caught by the clj-kondo hook, which resolves next.jdbc/execute! and works
  ;; from the SINK side -- so it never needs to match the destructured source
  ;; at all. Recorded as a miss for both taint engines until the hook rules
  ;; were scored, which is what the corpus is for.
  {"opengrep" "The pattern language cannot express nested map destructuring:
               (defn $N [{{:keys [$P]} :params} ...] ...) matches nothing at
               all, in taint mode or plain search. Destructured ring handlers
               are idiomatic, so a source written this way is invisible."}}

 {:file "hard_via_map.clj" :cwe 89 :expect #{"clj-sql-injection"}
  :why "taint stored under a map key and read back out"}

 {:file "hard_via_collection.clj" :cwe 89 :expect #{"clj-sql-injection"}
  :why "taint put in a vector and taken out with first"}

 {:file "hard_anon_fn.clj" :cwe 89 :expect #{"clj-sql-injection"}
  :why "taint passed to an immediately-invoked anonymous fn"}

 {:file "hard_when_let.clj" :cwe 89 :expect #{"clj-sql-injection"}
  :why "binding through when-let"}

 {:file "hard_multi_arity.clj" :cwe 89 :expect #{"clj-sql-injection"}
  :why "multi-arity defn where one arity delegates to another -- the shape
        per-arity taint signatures exist for"}

 {:file "hard_safe_sanitised.clj" :cwe 79 :expect #{}
  :why "HARD NEGATIVE. escape-html is applied to the tainted value before it
        reaches raw, so the sanitiser must be honoured"}
 ;; --- Datomic. Measured 2026-08-04 across lume, sur and forma: 148 d/q and
 ;; 54 d/transact against 48 jdbc/execute. The dominant data path in this
 ;; organisation's Clojure had no taint rule at all until these.

 {:file "datomic_query_built.clj" :cwe 943
  :expect #{"clj-datalog-query-built" "clj-code-injection"}
  :why "the QUERY is built from request input. Both rules are correct here:
        the query is assembled by string building and then read back with
        read-string, which is two weaknesses in one line"}

 {:file "safe_datomic_param.clj" :cwe 943 :expect #{}
  :why "HARD NEGATIVE. The tainted value is passed as an :in argument, which
        is the correct way to use a Datalog query -- the same distinction as a
        bound SQL parameter, and the same trap"}

 {:file "safe_datomic_literal.clj" :cwe 943 :expect #{}
  :why "a quoted literal query with no user input"}

 ;; --- Cross-file. The shape that actually dominates: measured across lume,
 ;; sur and forma, 26 files hold a source and 46 hold a sink, and only 4 hold
 ;; both. An intra-file engine can examine 4 files out of 181 here, so these
 ;; cases are the difference between a tool that applies and one that does not.

 {:file "xfile/handler.clj" :cwe 89 :expect #{"clj-sql-injection"}
  :why "source in corpus.xfile.handler, sink in corpus.xfile.db. This is what
        a real handler-plus-persistence split looks like"
  :known-miss
  {"opengrep" "Intra-file only. Cross-file dataflow is Semgrep's commercial
               engine; the CE fork does not have it, measured."}}

 {:file "xfile/safe_handler.clj" :cwe 89 :expect #{}
  :why "same call, constant query"}
 ;; --- clj-kondo hook rules. Eight of the nine registered rules that had no
 ;; automated test of any kind: they live in net.typemark.sonar.security rather
 ;; than in plugin code, so the suite never named them, and the whole evidence
 ;; for all eight was one MD5 probe run by hand. They are the crypto set, which
 ;; makes them the worst possible place to be relying on that.
 ;; Scored with `clojure -M:corpus <kondo.json> kondo`.

 {:file "hooks/weak_hash.clj" :cwe 328 :expect #{"weak-hash-algorithm"}
  :why "MD5 for a digest"}
 {:file "hooks/safe_hash.clj" :cwe 328 :expect #{}
  :why "SHA-256 is not a finding"}

 {:file "hooks/cipher_ecb.clj" :cwe 327 :expect #{"cipher-ecb-mode"}
  :why "ECB named explicitly"}
 {:file "hooks/cipher_bare_defaults_ecb.clj" :cwe 327 :expect #{"cipher-ecb-mode"}
  :why "SunJCE defaults a bare transformation to ECB. The commonest real ECB
        bug on the JVM, and invisible to a rule that only looks for the string"}
 {:file "hooks/weak_cipher.clj" :cwe 327 :expect #{"weak-cipher-algorithm"}
  :why "DES"}
 {:file "hooks/safe_cipher.clj" :cwe 327 :expect #{}
  :why "HARD NEGATIVE. AES/GCM names a mode and is the right answer"}

 {:file "hooks/weak_tls.clj" :cwe 326 :expect #{"weak-tls-protocol"}
  :why "TLSv1"}
 {:file "hooks/safe_tls.clj" :cwe 326 :expect #{}
  :why "HARD NEGATIVE. TLSv1.3 shares a prefix with TLSv1 and must not match"}

 {:file "hooks/eval_dynamic.clj" :cwe 94 :expect #{"eval-of-dynamic-value"}
  :why "eval of a parameter"}
 {:file "hooks/safe_eval_literal.clj" :cwe 94 :expect #{}
  :why "HARD NEGATIVE. eval of a quoted literal is a warm-up, not a weakness"}

 {:file "hooks/read_string_untrusted.clj" :cwe 502 :expect #{"read-string-untrusted"}
  :why "clojure.core/read-string honours *read-eval*"}
 {:file "hooks/safe_edn_read_string.clj" :cwe 502 :expect #{}
  :why "HARD NEGATIVE. clojure.edn/read-string is the fix"}

 {:file "hooks/insecure_random.clj" :cwe 338 :expect #{"insecure-random"}
  :why "rand-int delegates to java.util.Random"}
 {:file "hooks/safe_secure_random.clj" :cwe 338 :expect #{}
  :why "SecureRandom"}

 {:file "hooks/shell_injection.clj" :cwe 78 :expect #{"shell-command-injection"}
  :why "a computed shell argument"}
 {:file "hooks/safe_shell_literal.clj" :cwe 78 :expect #{}
  :why "every argument a literal"}

 {:file "hooks/reflective_call.clj" :cwe 470 :expect #{"reflective-call"}
  :why "resolve on a computed name"}
 {:file "hooks/safe_resolve_literal.clj" :cwe 470 :expect #{}
  :why "HARD NEGATIVE. resolve of a quoted symbol selects nothing dynamically"}
 ;; --- Tenancy. This rule ships OFF and is a sweep aid, not a gate: deciding
 ;; whether a query SHOULD be tenant-scoped needs to know which entities are
 ;; tenanted, and admin surfaces legitimately read across tenants. These cases
 ;; pin the false-positive classes that were removed so they cannot return.
 ;; Scored with the `kondo`-style plugin rules via the test suite, not here --
 ;; listed for the record of what the rule does and does not claim.

 {:file "tenancy/unscoped_document_query.clj" :cwe 639 :expect #{}
  :why "RECORD ONLY. Fires, and correctly -- but the rule is off by default
        and is not scored, because a hand-classified sample put its precision
        near a third. rules-detection-test asserts the behaviour instead"}

 {:file "tenancy/safe_scoped_query.clj" :cwe 639 :expect #{}
  :why "the scope is in the query, which is the fix"}

 {:file "tenancy/safe_shared_taxonomy.clj" :cwe 639 :expect #{}
  :why "HARD NEGATIVE. The taxonomy classifies product definitions and is the
        same for every tenant. Largest false-positive class before the fix"}

 {:file "tenancy/safe_pull_by_eid.clj" :cwe 639 :expect #{}
  :why "HARD NEGATIVE. A pull takes an id the caller already holds; 40 of the
        original 124 findings were pulls and none was a scan"}

 {:file "tenancy/safe_compat_layer.clj" :cwe 639 :expect #{}
  :why "HARD NEGATIVE. std/conn relate product definitions, not tenant data"}]
