;; The analysis is REQUIRED, not owned. typmk/sift holds every namespace
;; reachable from the analysis facade and nothing that touches org.sonar; it is
;; .cljc and also runs as ClojureScript inside defnet. This repo holds
;; the plugin -- sensors, rule definitions, profiles, measures -- and maps the
;; facade's findings onto Sonar's API. The split was computed: zero namespaces
;; on this side require a sift namespace directly.
{:paths ["src" "resources"]

 ;; `clojure -Ttools install-latest :lib io.github.typmk/sonar-clojure :as
 ;; sonar-clojure`, then `clojure -Tsonar-clojure prepare` in a project.
 :tools/usage {:ns-default net.typemark.sonar.prepare}

 :deps {org.clojure/clojure   {:mvn/version "1.12.0"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        rewrite-clj/rewrite-clj  {:mvn/version "1.2.55"}
        ;; A sibling checkout is not a dependency: `:local/root "../sift"` resolved
        ;; on one laptop and on no runner. Pinned to a sha on the public repo;
        ;; `clojure -M:test:local` swaps in ../sift for the dev loop.
        io.github.typmk/sift  {:git/url "https://github.com/typmk/sift.git"
                               :git/tag "v0.2.0"
                               :git/sha "8c195369d9b4c391213e5d1f67764c49ee7d0a10"}}

 :aliases
 {;; Sonar supplies the API at runtime. On the compile classpath only —
  ;; bundling it into the plugin jar makes the scanner load two copies of
  ;; every interface and every extension fails an instanceof check.
  :provided
  {:extra-deps {org.sonarsource.api.plugin/sonar-plugin-api {:mvn/version "13.9.0.4428"}}}

  ;; clj-kondo is a BUILD dependency, not a runtime one: the rule catalogue
  ;; is generated from its default config so the two cannot drift.
  :gen-rules
  {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2026.07.24"}}
   :exec-fn    net.typemark.sonar.gen/write-linters!}

  ;; Runs against target/classes: the AOT artefacts are the thing under
  ;; test, so `clojure -T:build compile-clj*` must run first.
  :test
  {:extra-paths ["test" "target/classes"]
   ;; sonar-plugin-api-impl carries SensorContextTester -- SonarSource's own
   ;; in-memory SensorContext. A sensor tested only through its helpers is
   ;; tested on the parts that cannot fail; running it against a real context
   ;; is what proves a measure and an issue actually arrive.
   :extra-deps  {org.sonarsource.api.plugin/sonar-plugin-api {:mvn/version "13.9.0.4428"}
                 org.sonarsource.sonarqube/sonar-plugin-api-impl {:mvn/version "10.7.0.96327"}
                 org.clojure/test.check {:mvn/version "1.1.3"}
                 io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   ;; sift's own suite used to run here too, via -d ../sift/test -- 86 tests
   ;; ran where 132 should have when the second -d was missing, and a suite
   ;; that silently shrinks is a suite that stopped checking. With sift a git
   ;; dep that path does not exist; its suite runs in typmk/sift's own CI,
   ;; and :local brings it back for the dev loop.
   :main-opts   ["-m" "cognitect.test-runner" "-d" "test"]
   :exec-fn     cognitect.test-runner.api/test}

  ;; The dev loop against the sibling checkout: clojure -M:test:local
  :local
  {:override-deps {io.github.typmk/sift {:local/root "../sift"}}
   :extra-paths   ["../sift/test"]
   :main-opts     ["-m" "cognitect.test-runner" "-d" "test" "-d" "../sift/test"]}

  :coverage
  {:extra-paths ["test" "target/classes"]
   :extra-deps  {org.sonarsource.api.plugin/sonar-plugin-api {:mvn/version "13.9.0.4428"}
                 org.sonarsource.sonarqube/sonar-plugin-api-impl {:mvn/version "10.7.0.96327"}
                 org.clojure/test.check {:mvn/version "1.1.3"}
                 cloverage/cloverage {:mvn/version "1.2.4"}}
   ;; Excluded: the namespaces carrying :gen-class. Their tests instantiate the
   ;; AOT'd class from target/classes while cloverage instruments the source
   ;; var, so real exercise does not count against them -- completeness-sensor
   ;; has a full SensorContextTester suite and still measured 6.25%. A wrong
   ;; number is worse than no number, so they are named here rather than left
   ;; to look untested. What they do IS covered, by completeness-sensor-test
   ;; and packaging-test, which read the built jar.
   :main-opts   ["-m" "cloverage.coverage" "--lcov" "--codecov"
                 "-p" "src" "-s" "test"
                 "-e" "net.typemark.sonar.(plugin|language|rules|profile|sensor|source-sensor|coverage-sensor|test-sensor|completeness-sensor|external-sensor|external-rules|metrics-def|gen)"]}

  ;; Scores an analyzer against corpus/. Recall AND precision: a rule that
  ;; fires on everything has perfect recall, and one that never fires has
  ;; perfect precision.
  :corpus
  {:extra-paths ["corpus"]
   :main-opts   ["-m" "score"]}

  ;; src and resources are on the build classpath so the jar's description can
  ;; be produced by the plugin's own provenance code rather than by a second
  ;; copy of the same string. "." carries build.clj itself, which -T supplies
  ;; by default only when :paths is unset.
  :build
  {:paths      ["." "src" "resources"]
   :deps       {io.github.clojure/tools.build {:mvn/version "0.10.12"}
                org.sonarsource.api.plugin/sonar-plugin-api {:mvn/version "13.9.0.4428"}
                org.clojure/data.json {:mvn/version "2.5.2"}}
   :ns-default build}}}
